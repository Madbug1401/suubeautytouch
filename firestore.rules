rules_version = '2';

// Su Beauty Touch — regras do Firestore
// Admin = utilizador autenticado com documento em /admins/{uid} (criado à mão na consola).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- Admins ----------
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // geridos só pela consola
    }

    // ---------- Agendamentos (dados pessoais) ----------
    function validAgendamentoPublico(id) {
      let d = request.resource.data;
      let slot = d.data + '_' + d.hora;
      return d.keys().hasOnly(['nome', 'telefone', 'servico', 'cilios', 'data', 'hora', 'observacoes', 'status', 'createdAt'])
        && d.keys().hasAll(['nome', 'telefone', 'servico', 'data', 'hora', 'status', 'createdAt'])
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 100
        && d.telefone is string && d.telefone.size() >= 7 && d.telefone.size() <= 25
        && d.servico in ['Soft Glam', 'Glow Glam', 'Full Glam']
        && (!('cilios' in d) || d.cilios == null || d.cilios in ['Simples / Natural', 'Cheio / Volumoso'])
        && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.hora is string && d.hora.matches('^[0-9]{2}:[0-9]{2}$')
        && (!('observacoes' in d) || (d.observacoes is string && d.observacoes.size() <= 500))
        && d.status == 'pendente'
        && d.createdAt == request.time
        // o horário de início tem de ser reservado no mesmo batch
        && getAfter(/databases/$(database)/documents/ocupacao/$(slot)).data.agendamentoId == id;
    }

    match /agendamentos/{id} {
      allow create: if isAdmin() || validAgendamentoPublico(id);
      allow read, update, delete: if isAdmin();
    }

    // ---------- Ocupação (horários ocupados, SEM dados pessoais) ----------
    // Um documento por bloco de 30 min: id = "AAAA-MM-DD_HH:MM".
    // Criar sobre um bloco existente é "update" → negado ao público → impede marcações duplicadas.
    match /ocupacao/{slotId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['data', 'hora', 'agendamentoId'])
        && slotId == request.resource.data.data + '_' + request.resource.data.hora
        && !exists(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId))
        && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.agendamentoId)).data.data
             == request.resource.data.data
      );
      allow update, delete: if isAdmin();
    }

    // ---------- Conteúdo público do site ----------
    match /imagens/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tudo o resto: fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

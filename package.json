{
  "name": "su-beauty-touch",
  "private": true,
  "description": "Site e painel de gestão da Su Beauty Touch (maquilhagem profissional).",
  "scripts": {
    "deploy": "npx firebase-tools deploy",
    "web:dev": "npm --prefix web run dev",
